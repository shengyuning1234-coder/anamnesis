# Host paths, not container paths. Windows uses forward slashes.
WORDS_DATA_DIR=./docker-data/words
WEBUI_DATA_DIR=./docker-data/openwebui

# These must be URLs the user's BROWSER can reach, with no trailing paths.
APP_PUBLIC_URL=http://localhost:5050
APP_PORT=5050
BIND_ADDRESS=0.0.0.0

# Set 0 and recreate container after first password setup.
ALLOW_INITIAL_SETUP=1
# Only when behind your reverse proxy: its actual source IP as seen by the container.
TRUSTED_PROXY=

# Build-time prefetch; missing model files can also be fetched at startup.
BUNDLE_EMBEDDING_MODEL=1
AUTO_DOWNLOAD_MODELS=1
PREFETCH_WHISPER=1
